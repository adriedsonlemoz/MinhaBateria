<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sourceProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/sourceProfileBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Voltar"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Perfil da fonte"
            android:textColor="@color/text_primary"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cadastre a fonte usando os dados reais da etiqueta. Preencha somente o que estiver disponível; o app não inventa especificações."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="TIPO DA FONTE"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/sourceTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_card"
                android:padding="10dp">

                <RadioButton android:id="@+id/sourceTypeSolar" android:layout_width="match_parent" android:layout_height="44dp" android:buttonTint="@color/accent_green" android:gravity="center_vertical" android:text="Painel solar" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/sourceTypeCharger" android:layout_width="match_parent" android:layout_height="44dp" android:buttonTint="@color/accent_green" android:gravity="center_vertical" android:text="Carregador" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/sourceTypePowerBank" android:layout_width="match_parent" android:layout_height="44dp" android:buttonTint="@color/accent_green" android:gravity="center_vertical" android:text="Power bank" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/sourceTypeOther" android:layout_width="match_parent" android:layout_height="44dp" android:buttonTint="@color/accent_green" android:gravity="center_vertical" android:text="Outra fonte" android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:id="@+id/sourceDataHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Escolha o tipo da fonte para receber orientação de preenchimento."
                android:textColor="@color/accent_blue"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="DADOS DA ETIQUETA"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/sourceBrandInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:hint="Marca (ex.: Samsung, Xiaomi, Baseus)"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/sourceModelInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Modelo da etiqueta (ex.: EP-TA800)"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/sourcePowerInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Potência máxima declarada em W (ex.: 25)"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sourcePowerHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/electricalDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/sourceOutputsInput"
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_input"
                    android:gravity="top|start"
                    android:hint="Saídas da etiqueta&#10;Ex.: 5V⎓3A; 9V⎓2,77A; PPS 3,3–11V⎓2,25A"
                    android:inputType="textMultiLine"
                    android:paddingTop="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/sourceTechnologyInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Tecnologia (ex.: USB-PD, PPS, Quick Charge)"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/sourcePortInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Porta usada (ex.: USB-C, USB-A)"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cableDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/sourceCableInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:hint="Cabo opcional (ex.: 5 A, 100 W)"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/powerBankDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/sourceCapacityInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:hint="Capacidade declarada em mAh (ex.: 20000)"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Preencha também saídas, protocolo e porta quando essas informações estiverem na etiqueta."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/solarDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/sourceVoltageInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:hint="Tensão nominal da etiqueta em V"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/sourceCurrentInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Corrente nominal da etiqueta em A"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/sourceControllerInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Controlador/conversor usado (opcional)"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="NOME PERSONALIZADO (OPCIONAL)"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/sourceCustomNameInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:hint="Deixe vazio para gerar automaticamente"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOME DO PERFIL"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sourceNamePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Perfil da fonte"
                    android:textColor="@color/accent_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Os dados da etiqueta servem como referência nominal. As medições do Android mostram o que é observado no aparelho e não medem diretamente a saída da fonte."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Space android:layout_width="1dp" android:layout_height="18dp" />

            <Button
                android:id="@+id/saveSourceProfileButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary_button"
                android:minHeight="0dp"
                android:text="Salvar perfil"
                android:textColor="#07110A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/cancelSourceProfileButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="0dp"
                android:text="Cancelar"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
