<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sourceProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/sourceProfileBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Voltar"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Perfil da fonte"
            android:textColor="@color/text_primary"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Identifique a fonte usada neste teste. Esse dado não substitui a conexão que o Android detecta."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="TIPO DA FONTE"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/sourceTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_card"
                android:padding="10dp">

                <RadioButton android:id="@+id/sourceTypeSolar" android:layout_width="match_parent" android:layout_height="44dp" android:buttonTint="@color/accent_green" android:gravity="center_vertical" android:text="Painel solar" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/sourceTypeCharger" android:layout_width="match_parent" android:layout_height="44dp" android:buttonTint="@color/accent_green" android:gravity="center_vertical" android:text="Carregador" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/sourceTypePowerBank" android:layout_width="match_parent" android:layout_height="44dp" android:buttonTint="@color/accent_green" android:gravity="center_vertical" android:text="Power bank" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/sourceTypeOther" android:layout_width="match_parent" android:layout_height="44dp" android:buttonTint="@color/accent_green" android:gravity="center_vertical" android:text="Outra fonte" android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="NOME DO PERFIL"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/sourceNameInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:hint="Ex.: Painel 8W"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="POTÊNCIA NOMINAL"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/sourcePowerInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:hint="Ex.: 8"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sourcePowerHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <Space android:layout_width="1dp" android:layout_height="18dp" />

            <Button
                android:id="@+id/saveSourceProfileButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary_button"
                android:minHeight="0dp"
                android:text="Salvar perfil"
                android:textColor="#07110A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/cancelSourceProfileButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="0dp"
                android:text="Cancelar"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
