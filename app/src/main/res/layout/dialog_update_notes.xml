<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="18dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOVIDADES"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="O Minha Bateria foi atualizado"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/updateNotesVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_status_chip"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="Versão 1.0.34+35"
        android:textColor="@color/accent_blue"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/updateNotesBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="5dp"
        android:text="• Agora, Sessão e Gráficos foram reorganizados para mostrar primeiro o que está acontecendo, depois a explicação e só então os dados técnicos.\n\n• O app agora classifica carga normal, lenta, oscilando ou com possível problema usando as medições reais disponíveis.\n\n• Perfil da fonte ficou mais rápido: escolha o tipo, marca, modelo e potência; dados da etiqueta ficam recolhidos por padrão.\n\n• Gráficos ganharam resumo em linguagem simples, período compacto, escala mais segura e detalhes técnicos sob demanda."
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Este aviso aparece somente uma vez em cada nova versão."
        android:textColor="@color/text_muted"
        android:textSize="10sp" />

    <Button
        android:id="@+id/updateNotesContinueButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_primary_button"
        android:minHeight="0dp"
        android:text="Continuar"
        android:textAllCaps="false"
        android:textColor="#07110A"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
