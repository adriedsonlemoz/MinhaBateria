<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="18dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOVIDADES"
        android:textColor="@color/accent_green"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="O Minha Bateria foi atualizado"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/updateNotesVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_status_chip"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="Versão 1.0.39+40"
        android:textColor="@color/accent_blue"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/updateNotesBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="5dp"
        android:text="• Os 24 avisos de voz padrão foram remasterizados para maior loudness, deixando a fala mais próxima do nível percebido de uma reprodução de mídia.

• O volume padrão dos avisos agora começa em 100%; o controle, os eventos, o teste e os áudios personalizados continuam disponíveis.

• O monitoramento usa fila curta, prioridades e controle de estado para evitar repetição enquanto a condição continua verdadeira.

• Histórico ganhou modo Gerenciar separado do modo Comparar, seleção múltipla, selecionar todas, excluir selecionadas e excluir todo o histórico.

• Confirmações de exclusão e o aviso de fonte conectada agora usam componentes personalizados com a identidade visual do Minha Bateria."
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Este aviso aparece somente uma vez em cada nova versão."
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/updateNotesContinueButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_primary_button"
        android:minHeight="0dp"
        android:text="Continuar"
        android:textAllCaps="false"
        android:textColor="#07110A"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
