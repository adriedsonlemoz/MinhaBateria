<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_session_guide"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PREENCHIMENTO RÁPIDO"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Toque nas opções para preencher. Digite somente quando sua etiqueta tiver um valor diferente."
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/suggestBrandButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Escolher marca"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/suggestModelButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Modelo / preset"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/suggestPowerButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_secondary_button"
        android:ellipsize="end"
        android:maxLines="1"
        android:minHeight="0dp"
        android:text="Escolher potência"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/suggestTechPortRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/suggestTechnologyButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Escolher protocolo"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/suggestPortButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Escolher porta"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/suggestOutputsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/suggestOutputsButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Escolher saída comum"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/suggestCapacityRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/suggestCapacityButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_secondary_button"
            android:minHeight="0dp"
            android:text="Escolher capacidade"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/suggestSolarRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/suggestVoltageButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:minHeight="0dp"
            android:text="Escolher tensão"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/suggestCurrentButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:minHeight="0dp"
            android:text="Escolher corrente"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/suggestControllerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/suggestControllerButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Escolher controlador"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/suggestCableRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/suggestCableButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Escolher cabo"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
