<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONFIGURAÇÃO BÁSICA"
        android:textColor="@color/accent_green"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Use os seletores. Digite manualmente somente se a etiqueta tiver algo diferente."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/suggestBrandButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:text="Marca ▾"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/suggestModelButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:text="Modelo ▾"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/suggestPowerButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_secondary_button"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:minHeight="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Potência  •  Escolher ▼"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/suggestCapacityRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/suggestCapacityButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_secondary_button"
            android:gravity="center_vertical|start"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Capacidade  •  Escolher ▼"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/suggestAdvancedContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/suggestTechPortRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/suggestTechnologyButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="0dp"
                android:text="Protocolo ▼"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
            <Space android:layout_width="6dp" android:layout_height="1dp" />
            <Button
                android:id="@+id/suggestPortButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="0dp"
                android:text="Porta ▼"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestOutputsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/suggestOutputsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="0dp"
                android:text="Saída da etiqueta ▼"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestSolarRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button
                android:id="@+id/suggestVoltageButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="0dp"
                android:text="Tensão ▼"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
            <Space android:layout_width="6dp" android:layout_height="1dp" />
            <Button
                android:id="@+id/suggestCurrentButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="0dp"
                android:text="Corrente ▼"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestControllerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/suggestControllerButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="0dp"
                android:text="Controlador / conversor ▼"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestCableRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/suggestCableButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="0dp"
                android:text="Cabo utilizado ▼"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
