<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PREENCHIMENTO RÁPIDO"
        android:textColor="@color/accent_green"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Toque nas opções para preencher marca, modelo, potência e dados comuns sem precisar digitar. O campo manual continua disponível para etiquetas diferentes."
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/suggestBrandButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:minHeight="0dp"
            android:text="Escolher marca"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/suggestModelButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Modelo / preset"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/suggestPowerButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Escolher potência"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/suggestOutputsButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Escolher saída comum"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/suggestTechPortRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/suggestTechnologyButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Escolher protocolo"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/suggestPortButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:minHeight="0dp"
            android:text="Escolher porta"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
