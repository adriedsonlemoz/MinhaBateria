<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sessionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sessão"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumo simples da carga atual"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/panel_session_insights" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FONTE DESTA SESSÃO"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sessionSourceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Perfil não configurado"
                    android:textColor="@color/accent_blue"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sessionSourceReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sem referência nominal"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <include
                layout="@layout/panel_session_simple_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/sessionDetailsToggle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_secondary_button"
                android:gravity="center"
                android:text="Ver detalhes técnicos"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sessionHelpLink"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="ⓘ O que significam W, mA, Wh e mAh?"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/technicalDetailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEMPO E CONTINUIDADE" android:textColor="@color/accent_green" android:textSize="11sp" android:textStyle="bold" />
                    <include layout="@layout/session_row_elapsed" />
                    <include layout="@layout/session_row_charging_time" />
                    <include layout="@layout/session_row_interruptions" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ENERGIA ESTIMADA" android:textColor="@color/accent_blue" android:textSize="11sp" android:textStyle="bold" />
                    <include layout="@layout/session_row_energy" />
                    <include layout="@layout/session_row_charge" />
                    <include layout="@layout/session_row_average_power" />
                    <include layout="@layout/session_row_peak_power" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ELÉTRICO" android:textColor="@color/accent_blue" android:textSize="11sp" android:textStyle="bold" />
                    <include layout="@layout/session_row_average_current" />
                    <include layout="@layout/session_row_current_range" />
                    <include layout="@layout/session_row_average_voltage" />
                    <include layout="@layout/session_row_voltage_range" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEMPERATURA E BATERIA" android:textColor="@color/accent_orange" android:textSize="11sp" android:textStyle="bold" />
                    <include layout="@layout/session_row_average_temperature" />
                    <include layout="@layout/session_row_max_temperature" />
                    <include layout="@layout/session_row_battery_range" />
                    <include layout="@layout/session_row_battery_gain" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Wh, mAh e médias são estimados a partir das leituras válidas observadas no aparelho; não representam medição direta da saída da fonte."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/bottom_tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_tabs_height" />
</LinearLayout>
