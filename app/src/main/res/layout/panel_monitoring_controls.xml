<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Monitoramento contínuo"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/startMonitoringButton"
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Iniciar"
            android:textSize="11sp" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/stopMonitoringButton"
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Parar"
            android:textSize="11sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/resumeAfterBootCheck"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:buttonTint="@color/accent_green"
        android:gravity="center_vertical"
        android:padding="0dp"
        android:singleLine="true"
        android:text="Retomar após reiniciar"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
