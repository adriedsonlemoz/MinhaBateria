<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="82dp"
    android:orientation="vertical"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/usageAppRank"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_status_chip"
            android:gravity="center"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="1" />

        <ImageView
            android:id="@+id/usageAppIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:contentDescription="Ícone do aplicativo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/usageAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Minha Bateria" />

            <TextView
                android:id="@+id/usageAppDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="5 min em primeiro plano" />
        </LinearLayout>

        <TextView
            android:id="@+id/usageAppShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:minWidth="46dp"
            android:textColor="@color/accent_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="63%" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/usageAppProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginStart="46dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_usage_activity"
        tools:progress="63" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:layout_marginTop="4dp"
        android:text="da atividade observada"
        android:textColor="@color/text_muted"
        android:textSize="10sp" />
</LinearLayout>
