<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/usageAppRank"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_status_chip"
        android:gravity="center"
        android:text="—"
        android:textColor="@color/accent_blue"
        android:textSize="10sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/usageAppIcon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="9dp"
        android:contentDescription="Ícone do aplicativo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/usageAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Aplicativo"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/usageAppDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/usageAppImpact"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_status_chip"
        android:gravity="center"
        android:minWidth="78dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="—"
        android:textColor="@color/accent_orange"
        android:textSize="9sp"
        android:textStyle="bold" />
</LinearLayout>
