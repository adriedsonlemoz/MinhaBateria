<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:background="@color/surface"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/tabNow"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:text="Agora" android:textColor="@color/accent_green" android:textSize="12sp" android:textStyle="bold" />
    <TextView
        android:id="@+id/tabCharts"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:enabled="false" android:gravity="center" android:text="Gráficos" android:textColor="@color/text_muted" android:textSize="12sp" />
    <TextView
        android:id="@+id/tabSession"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:enabled="false" android:gravity="center" android:text="Sessão" android:textColor="@color/text_muted" android:textSize="12sp" />
    <TextView
        android:id="@+id/tabHistory"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:enabled="false" android:gravity="center" android:text="Histórico" android:textColor="@color/text_muted" android:textSize="12sp" />
</LinearLayout>
