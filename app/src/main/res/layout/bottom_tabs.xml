<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_tabs_height"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_bottom_tabs"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="5dp">

    <LinearLayout
        android:id="@+id/tabNow"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_tab_active"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="@dimen/bottom_icon_size"
            android:layout_height="@dimen/bottom_icon_size"
            android:contentDescription="Agora"
            android:src="@drawable/ic_tab_home" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Agora"
            android:textColor="@color/accent_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabCharts"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="false"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="@dimen/bottom_icon_size"
            android:layout_height="@dimen/bottom_icon_size"
            android:contentDescription="Gráficos"
            android:src="@drawable/ic_tab_charts" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Gráficos"
            android:textColor="@color/text_tab_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabSession"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="false"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="@dimen/bottom_icon_size"
            android:layout_height="@dimen/bottom_icon_size"
            android:contentDescription="Sessão"
            android:src="@drawable/ic_tab_session" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Sessão"
            android:textColor="@color/text_tab_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="false"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="@dimen/bottom_icon_size"
            android:layout_height="@dimen/bottom_icon_size"
            android:contentDescription="Histórico"
            android:src="@drawable/ic_tab_history" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Histórico"
            android:textColor="@color/text_tab_inactive"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
