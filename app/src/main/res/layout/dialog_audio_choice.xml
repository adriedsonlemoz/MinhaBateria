<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView android:id="@+id/audioChoiceTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/audioChoiceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <Button android:id="@+id/audioChoiceDefault" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="14dp" android:background="@drawable/bg_secondary_button" android:minHeight="0dp" android:text="Usar áudio padrão" android:textAllCaps="false" android:textColor="@color/text_primary" android:textStyle="bold" />
    <Button android:id="@+id/audioChoiceFile" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="7dp" android:background="@drawable/bg_secondary_button" android:minHeight="0dp" android:text="Escolher arquivo do dispositivo" android:textAllCaps="false" android:textColor="@color/text_primary" android:textStyle="bold" />
    <Button android:id="@+id/audioChoiceTest" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="7dp" android:background="@drawable/bg_primary_button" android:minHeight="0dp" android:text="▶ Testar áudio atual" android:textAllCaps="false" android:textColor="#07110A" android:textStyle="bold" />
    <Button android:id="@+id/audioChoiceClose" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="7dp" android:background="@android:color/transparent" android:minHeight="0dp" android:text="Fechar" android:textAllCaps="false" android:textColor="@color/text_muted" />
</LinearLayout>
