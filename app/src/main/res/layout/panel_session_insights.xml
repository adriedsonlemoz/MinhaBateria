<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_session_hero"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RESUMO"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sessionStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_status_chip"
            android:gravity="center"
            android:minWidth="118dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="●  Sem carregamento"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sessionInsightState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aguardando conexão"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sessionInsightHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Conecte uma fonte para iniciar uma nova sessão."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_icon_circle_blue"
            android:contentDescription="Estado da conexão"
            android:padding="17dp"
            android:src="@drawable/ic_session_plug" />
    </LinearLayout>

    <TextView
        android:id="@+id/sessionInsightPower"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_metric_card"
        android:padding="10dp"
        android:text="Potência: sem referência suficiente"
        android:textColor="@color/accent_blue"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sessionInsightStability"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_metric_card"
        android:padding="10dp"
        android:text="Estabilidade: aguardando amostras"
        android:textColor="@color/accent_green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sessionInsightDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="As classificações usam somente leituras observadas no aparelho."
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
