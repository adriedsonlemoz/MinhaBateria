<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minha Bateria"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/monitoringStateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Monitoramento inativo"
                    android:textColor="@color/accent_blue"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_status_chip"
                android:contentDescription="Configurações"
                android:padding="9dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/gaugeContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gauge_size"
            android:layout_marginTop="2dp">

            <com.minhabateria.app.ui.BatteryGaugeView
                android:id="@+id/batteryGauge"
                android:layout_width="@dimen/gauge_size"
                android:layout_height="@dimen/gauge_size"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/status_chip_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:minWidth="174dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Carregando"
            android:textSize="14sp"
            android:textStyle="bold" />

        <include
            layout="@layout/panel_measurements"
            android:layout_width="match_parent"
            android:layout_height="@dimen/measurements_height"
            android:layout_marginTop="6dp" />

        <include
            layout="@layout/panel_session_summary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/session_summary_height"
            android:layout_marginTop="6dp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <include
        layout="@layout/bottom_tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_tabs_height" />
</LinearLayout>
