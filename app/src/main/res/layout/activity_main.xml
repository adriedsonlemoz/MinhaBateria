<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/monitoringStateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="● Monitoramento inativo"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/measurementHelpButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_settings_circle"
                android:contentDescription="Entenda os dados"
                android:gravity="center"
                android:text="i"
                android:textColor="@color/accent_blue"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_settings_circle"
                android:contentDescription="Configurações"
                android:elevation="3dp"
                android:padding="11dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/gaugeContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gauge_size"
            android:layout_marginTop="@dimen/section_gap">

            <com.minhabateria.app.ui.BatteryGaugeView
                android:id="@+id/batteryGauge"
                android:layout_width="@dimen/gauge_size"
                android:layout_height="@dimen/gauge_size"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/remainingTimeText"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/status_chip_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:drawablePadding="9dp"
            android:gravity="center"
            android:minWidth="210dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Não está carregando"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <include
            layout="@layout/panel_measurements"
            android:layout_width="match_parent"
            android:layout_height="@dimen/measurements_height"
            android:layout_marginTop="@dimen/section_gap" />

        <include
            layout="@layout/panel_session_summary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/session_summary_height"
            android:layout_marginTop="@dimen/section_gap" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <include
        layout="@layout/bottom_tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_tabs_height" />
</LinearLayout>
