<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/monitoringStateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="● Monitoramento inativo"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/measurementHelpButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_settings_circle"
                android:contentDescription="Entenda os dados"
                android:gravity="center"
                android:text="i"
                android:textColor="@color/accent_blue"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_settings_circle"
                android:contentDescription="Configurações"
                android:elevation="2dp"
                android:padding="11dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/gaugeContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gauge_size"
            android:layout_marginTop="@dimen/section_gap">

            <com.minhabateria.app.ui.BatteryGaugeView
                android:id="@+id/batteryGauge"
                android:layout_width="@dimen/gauge_size"
                android:layout_height="@dimen/gauge_size"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/status_chip_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:maxLines="1"
            android:maxWidth="360dp"
            android:minWidth="220dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Status da bateria"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <include
            layout="@layout/panel_measurements"
            android:layout_width="match_parent"
            android:layout_height="@dimen/measurements_height"
            android:layout_marginTop="@dimen/section_gap" />

        <include
            layout="@layout/panel_session_summary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/session_summary_height"
            android:layout_marginTop="@dimen/section_gap" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_gap"
            android:layout_weight="1"
            android:foregroundGravity="center_vertical">

            <LinearLayout
                android:id="@+id/batteryUsagePreviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:elevation="1dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_circle_orange"
                    android:gravity="center"
                    android:text="⚡"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consumo de bateria"
                        android:textColor="@color/accent_orange"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/batteryUsagePreviewValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Descubra o que pode estar drenando mais rápido"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/batteryUsagePreviewHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Toque para analisar"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="›"
                    android:textColor="@color/accent_blue"
                    android:textSize="26sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <include
        layout="@layout/bottom_tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_tabs_height" />
</LinearLayout>
