<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="O app identifica como cada dado foi obtido. Valores ausentes permanecem como Indisponível."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="SISTEMA  •  bateria, status, conexão, tensão, corrente e temperatura"
        android:textColor="@color/accent_blue"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="CALCULADO  •  potência, tempo e picos derivados das leituras"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="ESTIMADO  •  reservado para integrações futuras, como Wh e mAh"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
